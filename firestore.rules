rules_version = '2';
// שלב 1 (מעבר): הכספות הפרטיות פתוחות רק למי שיש לו את המפתח הארוך מהקישור.
// הנתונים הישנים והפתוחים זמינים רק לקריאה, כדי להעביר אותם פעם אחת לכספת.
service cloud.firestore {
  match /databases/{database}/documents {

    // מחשבון ההוצאות: כל טיול נמצא בכספת ששמה הוא מפתח אקראי של 32 תווים לפחות.
    // אין כלל על /spaces עצמו, ולכן אי אפשר לבקש רשימה של הכספות.
    match /spaces/{space} {
      match /trip/meta {
        allow read, write: if space.size() >= 32;
      }
      match /expenses/{id} {
        allow read, delete: if space.size() >= 32;
        allow create, update: if space.size() >= 32
                              && request.resource.data.amount is number
                              && request.resource.data.amount > 0
                              && request.resource.data.amount < 100000000;
      }
    }

    // הנתונים הישנים (לפני המעבר): קריאה בלבד, ורק סימון "הועבר" מותר.
    match /trip/meta {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migrated', 'migratedAt']);
    }
    match /expenses/{id} {
      allow read: if true;
    }

    // רכילותא: כל משתמש ניגש רק לדוחות של עצמו (שמורים מוצפנים).
    match /rk_users/{uid}/reports/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
